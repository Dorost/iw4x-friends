set scr_war_scorelimit "7500"
set scr_war_timelimit "10"
set sv_mapRotation "gametype war map mp_terminal map mp_rust map mp_highrise map mp_favela map mp_afghan map mp_derail map mp_estate map mp_quarry map mp_underpass map mp_nightshift map mp_rundown map mp_subbase map mp_boneyard map mp_checkpoint map mp_brecourt map mp_invasion"
set bots_manage_fill "0"
set bots_manage_fill_mode "0"
set bots_skill "0"
set sv_voice "1"
