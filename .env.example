# CrossOver bottle the dedicated server runs in. A separate bottle from the game
# avoids the two sharing one wineserver (stutter when getting hit).
IW4X_SERVER_BOTTLE=mw
# CrossOver bottle you play from (task game)
IW4X_GAME_BOTTLE=mw
# Override the MW2 folders if they're not in the default place inside the bottles
# IW4X_SERVER_DIR="$HOME/Library/Application Support/CrossOver/Bottles/mw/drive_c/Program Files (x86)/Call of Duty Modern Warfare 2"
# IW4X_GAME_DIR="$HOME/Library/Application Support/CrossOver/Bottles/mw/drive_c/Program Files (x86)/Call of Duty Modern Warfare 2"
IW4X_PORT=28960
UI_PORT=8080
# Password for the web UI (any username). Empty = no login (required on Linux/Docker).
UI_PASSWORD=
# Linux/Docker: domain the web UI is served on over HTTPS (Caddy)
DOMAIN=
# Linux/Docker: name players connect to (DNS-only A record to the server). Empty = DOMAIN
JOIN_HOST=
# Vultr API key for task vps:up / vps:down (Vultr: Account -> API)
VULTR_API_KEY=
